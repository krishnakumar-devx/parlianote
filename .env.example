# Parlianote settings. Paste your key after the = sign (no quotes, no spaces). Save the file, then restart the app.
# This file is private: it is listed in .gitignore and must never be uploaded to GitHub or shared in a chat.

# --- Option 1 (recommended): OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Option 2: Anthropic (only used if no OpenAI key is set) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Option 3: free local model through Ollama (only used if no key is set and Ollama is running) ---
OLLAMA_MODEL=llama3.2
OLLAMA_HOST=http://localhost:11434

# Set to 0 to switch AI-written answers off completely, even if a key is present.
AI_ANSWERS=1
